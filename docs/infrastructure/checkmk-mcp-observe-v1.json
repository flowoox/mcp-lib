{
  "schema_version": 1,
  "service": "checkmk-mcp",
  "status": "observe_v1_candidate",
  "contract": "flowoox.checkmk-diagnostics/1.0",
  "vendor_contract": {
    "verified_on": "2026-09-01",
    "stable_generation": "Checkmk 2.5",
    "rest_api_root": "/check_mk/api/1.0",
    "authentication": "Authorization: Bearer <automation-username> <automation-secret>",
    "least_privilege": "dedicated automation user with a deployment-owned monitoring-read role and contact-scoped host/service visibility",
    "operations": [
      "GET /version",
      "POST /domain-types/host/collections/all with an internally generated problem-state query and fixed columns",
      "POST /domain-types/service/collections/all with an internally generated problem-state query and fixed columns",
      "POST /objects/host/{validated_host_name}/collections/services with an internally generated problem-state query and fixed columns"
    ],
    "compatibility_notes": [
      "Checkmk changed monitored host and service query endpoints from GET to POST to support larger query bodies; Observe v1 uses the POST form only.",
      "The vendor MCP introduced in the Checkmk 3.0 beta line is explicitly experimental and is not a production dependency of this adapter.",
      "No /api/unstable endpoint is used."
    ],
    "primary_docs": [
      "https://docs.checkmk.com/latest/en/rest_api.html",
      "https://docs.checkmk.com/latest/en/wato_user.html",
      "https://checkmk.com/werk/17003",
      "https://checkmk.com/werk/17512",
      "https://checkmk.com/werk/22263"
    ]
  },
  "safety": {
    "default_mode": "read_only",
    "backend_attestation_required": true,
    "backend_role_attestation_required": true,
    "fixed_operation_allowlist": true,
    "fixed_columns": true,
    "generated_problem_queries_only": true,
    "generic_rest_proxy": false,
    "generic_livestatus_query": false,
    "unstable_api": false,
    "host_addresses": false,
    "contacts": false,
    "plugin_output": false,
    "performance_data": false,
    "comments": false,
    "configuration_endpoints": false,
    "downtime_or_acknowledgement_writes": false,
    "activation_or_discovery_actions": false,
    "query_budget": true,
    "audit_correlation": true,
    "aggregate_before_fan_out": true
  },
  "load_protection": {
    "problem_state_filter_applied_server_side": true,
    "collection_cursor_exposed": false,
    "bounded_result_projection": true,
    "oversized_response_rejected_before_json_parse": true,
    "rate_limit": true,
    "concurrency_limit": true,
    "request_timeout": true,
    "total_query_budget": true,
    "diagnostic_bundle_per_host_fan_out": false
  },
