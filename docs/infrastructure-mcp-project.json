  "roadmap_profiles": {
    "standard_read_only": {
      "default_mode": "read_only",
      "backend_connection": "explicit least-privilege read-only identity or authorization proxy",
      "startup_policy": "fail closed when read-only backend mode cannot be asserted",
      "tool_surface": "typed explicit operation allowlist; no arbitrary URL, method, query, command, script or provider call",
      "audit": "actor, reason/source and correlation ID; credentials and unrestricted raw payloads excluded"
    },
    "agent_optimized_diagnostics": {
      "bounded_queries": true,
      "pagination": true,
      "sampling_after_raw_cost_accounting": true,
      "rate_limits": true,
      "timeouts": true,
      "query_budgets": ["requests", "items", "response_bytes", "fan_out", "elapsed_time"],
      "aggregation_before_fan_out": true,
      "cache_hints": true,
      "concurrency_caps": true,
      "server_load_protection": "reject over-broad work before dispatch and oversized responses before parsing"
    },
    "optional_write_layer": {
      "enabled_by_default": false,
      "identity": "separate least-privilege write identity",
      "lifecycle": ["plan", "approval", "change", "verify"],
      "required_controls": [
        "approval bound to exact target and desired state",
        "idempotency key",
        "pre-state capture",
        "rollback declaration where possible",
        "independent read-back verification",
        "structured audit and correlation ID"
      ]
    }
  },
