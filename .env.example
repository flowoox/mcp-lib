# Shared runtime
TZ=Europe/Berlin
APP_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
STATE_DB=/data/mcp-lib.sqlite3
DOWNLOADS_DIR=/downloads
LOG_LEVEL=INFO

# Control plane
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8080
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_LONG_RANDOM
SCHEDULE_ENABLED=true
SCHEDULE_HOUR=03
SCHEDULE_MINUTE=00
DISCOVERY_ALBUMS_PER_DAY=5
POLL_INTERVAL_SECONDS=60

# Spotify OAuth. Register this callback exactly in the Spotify developer app.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/spotify/callback
SPOTIFY_SCOPES=user-top-read user-read-private user-read-email user-library-read

# slskd API
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=CHANGE_ME_32_OR_MORE_CHARACTERS
SLSKD_USERNAME=admin
SLSKD_PASSWORD=CHANGE_ME_LONG_RANDOM
SLSKD_SEARCH_TIMEOUT=15
SLSKD_RESULT_LIMIT=200
SLSKD_MINIMUM_TRACKS=4
PREFERRED_AUDIO_FORMATS=flac,wav,alac,aiff,ape,wv,mp3,m4a,ogg,opus

# slskd container / Soulseek account
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=
SLSKD_SLSK_LISTEN_PORT=50300

# Traxx / BeMusic
TRAXX_URL=https://traxx.app.wohnhaas.ch
TRAXX_TOKEN=
TRAXX_TUS_ENDPOINT=/api/v1/tus/
TRAXX_VERIFY_TLS=true
TRAXX_UPLOAD_CHUNK_SIZE=8388608
# Optional after one live upload probe, for example:
# TRAXX_FILE_URL_TEMPLATE=/api/v1/file-entries/{file_entry_id}
TRAXX_FILE_URL_TEMPLATE=

# Automation safety. Discovery is automatic; downloading/importing is off by default.
AUTO_DOWNLOAD=false
AUTO_IMPORT=false
AUTHORIZED_LIBRARY=false
DEFAULT_RIGHTS_BASIS=
DEFAULT_RIGHTS_REFERENCE=
