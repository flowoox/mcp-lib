MCP_HOST=127.0.0.1
MCP_PORT=8091
MCP_TRUST_BOUNDARY=internal
# Deployment-owned topology. Do not commit real paths, share names or credentials.
# content_read is a second, per-root opt-in and defaults to false.
FILESHARE_ROOTS_JSON=[{"alias":"data","path":"D:\\Shares\\Data","share_name":"Data","description":"Example only","content_read":false}]
# Must only be true when the service identity has read-only filesystem/share privileges.
FILESHARE_BACKEND_READ_ONLY=false
FILESHARE_POWERSHELL_EXECUTABLE=powershell.exe
FILESHARE_ALLOW_REPARSE_POINTS=false
FILESHARE_MAX_PAGE_SIZE=100
FILESHARE_REQUEST_TIMEOUT_SECONDS=8

# Optional bounded content analysis. Keep disabled unless explicitly required.
# Enabling this also requires FILESHARE_BACKEND_READ_ONLY=true and content_read=true on at least one root.
FILESHARE_CONTENT_READ_ENABLED=false
FILESHARE_SAFE_TEXT_EXTENSIONS=.txt,.log,.csv,.json,.xml,.yaml,.yml,.md,.ini,.conf,.cfg
FILESHARE_MAX_TEXT_READ_BYTES=65536
FILESHARE_MAX_TEXT_CHARACTERS=32768
FILESHARE_MAX_TEXT_LINES=400
FILESHARE_MAX_TEXT_MATCHES=20
FILESHARE_MAX_TEXT_SNIPPET_CHARACTERS=240
FILESHARE_MAX_SEARCH_QUERY_CHARACTERS=128
FILESHARE_MAX_HASH_BYTES=33554432
