MCP_HOST=127.0.0.1
MCP_PORT=8091
MCP_TRUST_BOUNDARY=internal
# Deployment-owned topology. Do not commit real paths, share names or credentials.
FILESHARE_ROOTS_JSON=[{"alias":"data","path":"D:\\Shares\\Data","share_name":"Data","description":"Example only"}]
# Must only be true when the service identity has read-only filesystem/share privileges.
FILESHARE_BACKEND_READ_ONLY=false
FILESHARE_POWERSHELL_EXECUTABLE=powershell.exe
FILESHARE_ALLOW_REPARSE_POINTS=false
FILESHARE_MAX_PAGE_SIZE=100
FILESHARE_REQUEST_TIMEOUT_SECONDS=8
