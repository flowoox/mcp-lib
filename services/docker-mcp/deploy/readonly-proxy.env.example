# Bind to loopback for same-host deployments. For remote MCP access, bind only
# the dedicated management address and restrict ingress at the host/network firewall.
DOCKER_READONLY_PROXY_BIND_HOST=127.0.0.1
DOCKER_READONLY_PROXY_BIND_PORT=23760

# Local Docker Engine socket. Filesystem read-only mounting is not a protocol
# authorization boundary; the proxy process therefore applies an independent
# method/path/query allowlist before forwarding any request.
DOCKER_READONLY_PROXY_DOCKER_SOCKET=/var/run/docker.sock

# Runtime TLS material. Do not commit certificates, private keys or bearer tokens.
DOCKER_READONLY_PROXY_TLS_CERT_FILE=/run/secrets/docker-readonly-proxy/tls.crt
DOCKER_READONLY_PROXY_TLS_KEY_FILE=/run/secrets/docker-readonly-proxy/tls.key
DOCKER_READONLY_PROXY_BEARER_TOKEN_FILE=/run/secrets/docker-readonly-proxy/bearer.token

# Must match the Docker MCP API version. Requests for all other API versions fail closed.
DOCKER_READONLY_PROXY_API_VERSION=v1.47

# Independent upstream/load limits. Keep these equal to or tighter than the MCP limits.
DOCKER_READONLY_PROXY_MAX_PAGE_SIZE=100
DOCKER_READONLY_PROXY_MAX_LOG_WINDOW_SECONDS=3600
DOCKER_READONLY_PROXY_MAX_EVENT_WINDOW_SECONDS=300
DOCKER_READONLY_PROXY_UPSTREAM_TIMEOUT_SECONDS=8
DOCKER_READONLY_PROXY_MAX_RESPONSE_BYTES=16777216
DOCKER_READONLY_PROXY_MAX_CONCURRENCY=4
