# MCP transport security
MCP_HOST=127.0.0.1
MCP_PORT=8097
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Official UniFi Network Integration API.
# Local console example: https://unifi.example.invalid/proxy/network/integration
# Cloud connector example:
# https://api.ui.com/v1/connector/consoles/<deployment-owned-console-id>/proxy/network/integration
UNIFI_API_BASE_URL=
UNIFI_API_KEY=

# Fail-closed attestation: set true only when the API key is owned by a deployment-managed
# UniFi identity/role that is restricted to read-only access for the intended sites.
UNIFI_BACKEND_READ_ONLY=false
UNIFI_TLS_VERIFY=true
UNIFI_ALLOW_INSECURE_HTTP=false

UNIFI_MAX_PAGE_SIZE=100
UNIFI_MAX_SAMPLE_SIZE=50
UNIFI_MAX_OFFSET=5000
UNIFI_REQUEST_TIMEOUT_SECONDS=8
UNIFI_MAX_RESPONSE_BYTES=2097152
UNIFI_MAX_CONCURRENCY=2
UNIFI_RATE_LIMIT_PER_SECOND=0.5
UNIFI_CACHE_MAX_AGE_SECONDS=15

UNIFI_BUDGET_MAX_REQUESTS=6
UNIFI_BUDGET_MAX_ITEMS=300
UNIFI_BUDGET_MAX_RESPONSE_BYTES=6291456
UNIFI_BUDGET_MAX_FAN_OUT=4
UNIFI_BUDGET_TIMEOUT_SECONDS=30
