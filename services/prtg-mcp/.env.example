MCP_HOST=127.0.0.1
MCP_PORT=8090
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Deployment-owned PRTG endpoint and least-privilege API key.
PRTG_BASE_URL=https://prtg.example.invalid
PRTG_API_KEY=
# Fail closed unless the deployment asserts this credential/proxy is read-only.
PRTG_BACKEND_READ_ONLY=false
PRTG_ALLOW_INSECURE_HTTP=false
PRTG_TLS_VERIFY=true

PRTG_MAX_PAGE_SIZE=100
PRTG_MAX_SAMPLE_SIZE=50
PRTG_REQUEST_TIMEOUT_SECONDS=8
PRTG_MAX_RESPONSE_BYTES=2097152
PRTG_MAX_CONCURRENCY=2
PRTG_RATE_LIMIT_PER_SECOND=2
PRTG_CACHE_MAX_AGE_SECONDS=15
PRTG_HEALTH_MAX_AGE_SECONDS=120
PRTG_HISTORIC_MAX_WINDOW_HOURS=24

PRTG_BUDGET_MAX_REQUESTS=8
PRTG_BUDGET_MAX_ITEMS=500
PRTG_BUDGET_MAX_RESPONSE_BYTES=8388608
PRTG_BUDGET_MAX_FAN_OUT=8
PRTG_BUDGET_TIMEOUT_SECONDS=30
