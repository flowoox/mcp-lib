# MCP endpoint. Keep loopback unless the shared trust boundary is configured.
MCP_HOST=127.0.0.1
MCP_PORT=8089
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Fail-closed backend assertion. Set true only for a dedicated least-privilege reader.
WINDOWS_BACKEND_READ_ONLY=true
WINDOWS_REQUIRE_JEA=true
WINDOWS_POWERSHELL_EXECUTABLE=powershell.exe

# Product-neutral examples only. Keep real topology in deployment configuration/secrets.
WINDOWS_TARGETS_JSON={"local":{"computer_name":".","transport":"local"},"member-a":{"computer_name":"server01.example.test","transport":"winrm","configuration_name":"McpReadOnly"}}
WINDOWS_ALLOWED_EVENT_LOGS=System,Application

# Per-backend load guards.
WINDOWS_MAX_PAGE_SIZE=100
WINDOWS_MAX_SAMPLE_SIZE=50
WINDOWS_REQUEST_TIMEOUT_SECONDS=20
WINDOWS_MAX_RESPONSE_BYTES=2097152
WINDOWS_MAX_CONCURRENCY=2
WINDOWS_RATE_LIMIT_PER_SECOND=2
WINDOWS_CACHE_MAX_AGE_SECONDS=10

# One agent/tool invocation budget, including bundle fan-out.
WINDOWS_BUDGET_MAX_REQUESTS=8
WINDOWS_BUDGET_MAX_ITEMS=500
WINDOWS_BUDGET_MAX_RESPONSE_BYTES=8388608
WINDOWS_BUDGET_MAX_FAN_OUT=8
WINDOWS_BUDGET_TIMEOUT_SECONDS=45
