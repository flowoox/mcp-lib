MCP_HOST=127.0.0.1
MCP_PORT=8098
MCP_TRUST_BOUNDARY=internal
MCP_AUTH_TOKEN=replace-with-long-random-token

# Origin of the Veeam Backup & Replication 13 REST service. Do not append /api or /api/v1.
VEEAM_API_BASE_URL=https://veeam.example.internal:9419
VEEAM_USERNAME=DOMAIN\\svc-mcp-veeam
VEEAM_PASSWORD=replace-me

# Required fail-closed attestations. Assign the built-in Backup Viewer role to this identity.
VEEAM_BACKEND_READ_ONLY=true
VEEAM_BACKEND_ROLE=Backup Viewer
VEEAM_API_VERSION=1.3-rev2
VEEAM_TLS_VERIFY=true

VEEAM_MAX_PAGE_SIZE=100
VEEAM_MAX_SAMPLE_SIZE=50
VEEAM_MAX_OFFSET=5000
VEEAM_MAX_HISTORY_HOURS=720
VEEAM_REQUEST_TIMEOUT_SECONDS=10
VEEAM_MAX_RESPONSE_BYTES=2097152
VEEAM_MAX_CONCURRENCY=2
VEEAM_RATE_LIMIT_PER_SECOND=1
