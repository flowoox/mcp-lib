# MCP listener/auth. Keep loopback unless fronted by an authenticated internal gateway.
MCP_HOST=127.0.0.1
MCP_PORT=8093
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Mandatory backend attestation. The runtime fails closed unless this is true.
FAILOVERCLUSTER_BACKEND_READ_ONLY=true

# Production default: only dedicated constrained JEA endpoints are accepted.
FAILOVERCLUSTER_REQUIRE_JEA=true
FAILOVERCLUSTER_POWERSHELL_EXECUTABLE=powershell.exe

# Logical aliases only. Keep real topology deployment-owned and outside the public repository.
# Example: {"prod":{"computer_name":"cluster-access.example.invalid","transport":"winrm","configuration_name":"Flowoox.FailoverCluster.ReadOnly"}}
FAILOVERCLUSTER_TARGETS_JSON={}

FAILOVERCLUSTER_MAX_PAGE_SIZE=100
FAILOVERCLUSTER_MAX_SAMPLE_SIZE=50
FAILOVERCLUSTER_REQUEST_TIMEOUT_SECONDS=20
FAILOVERCLUSTER_MAX_RESPONSE_BYTES=2097152
FAILOVERCLUSTER_MAX_CONCURRENCY=2
FAILOVERCLUSTER_RATE_LIMIT_PER_SECOND=2
FAILOVERCLUSTER_CACHE_MAX_AGE_SECONDS=5
FAILOVERCLUSTER_MAX_EVENT_LOOKBACK_MINUTES=1440
FAILOVERCLUSTER_MAX_GROUP_RESOURCES=64

FAILOVERCLUSTER_BUDGET_MAX_REQUESTS=8
FAILOVERCLUSTER_BUDGET_MAX_ITEMS=500
FAILOVERCLUSTER_BUDGET_MAX_RESPONSE_BYTES=8388608
FAILOVERCLUSTER_BUDGET_MAX_FAN_OUT=8
FAILOVERCLUSTER_BUDGET_TIMEOUT_SECONDS=45
