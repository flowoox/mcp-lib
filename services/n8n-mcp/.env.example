# MCP transport. Keep loopback/internal unless a protected reverse proxy is used.
MCP_HOST=127.0.0.1
MCP_PORT=8094
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Deployment-owned n8n Public API endpoint and dedicated read-only identity.
# The URL must end in /api/v1. Do not put credentials in the URL.
N8N_API_BASE_URL=https://n8n.example.invalid/api/v1
N8N_API_KEY=
N8N_BACKEND_READ_ONLY=false
N8N_ALLOW_INSECURE_HTTP=false
N8N_TLS_VERIFY=true

# Optional exact workflow ID allowlist. If set, execution list/get calls require
# a workflow_id and the adapter rejects results outside this allowlist.
N8N_ALLOWED_WORKFLOW_IDS=

# Agent/server-load safety.
N8N_MAX_PAGE_SIZE=100
N8N_MAX_SAMPLE_SIZE=50
N8N_REQUEST_TIMEOUT_SECONDS=8
N8N_MAX_RESPONSE_BYTES=2097152
N8N_MAX_CONCURRENCY=2
N8N_RATE_LIMIT_PER_SECOND=2
N8N_CACHE_MAX_AGE_SECONDS=10
N8N_BUDGET_MAX_REQUESTS=6
N8N_BUDGET_MAX_ITEMS=300
N8N_BUDGET_MAX_RESPONSE_BYTES=6291456
N8N_BUDGET_MAX_FAN_OUT=6
N8N_BUDGET_TIMEOUT_SECONDS=30
