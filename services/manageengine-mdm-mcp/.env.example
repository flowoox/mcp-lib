# MCP listener/auth. Bind externally only behind an authenticated reverse proxy or configure MCP auth.
MCP_HOST=127.0.0.1
MCP_PORT=8095
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Deployment-owned ManageEngine MDM Plus endpoint and read-only identity.
# Cloud: https://mdm.manageengine.com (or your regional domain), OAuth scope MDMOnDemand.MDMInventory.READ.
# On-prem: https://mdm.example.internal:8383 with an API key limited to MDMInventory.READ.
MDM_API_BASE_URL=
MDM_AUTH_MODE=cloud_oauth
MDM_API_TOKEN=
MDM_CUSTOMER_ID=
MDM_BACKEND_READ_ONLY=false
MDM_ALLOW_INSECURE_HTTP=false
MDM_TLS_VERIFY=true

MDM_MAX_PAGE_SIZE=100
MDM_MAX_SAMPLE_SIZE=50
MDM_REQUEST_TIMEOUT_SECONDS=8
MDM_MAX_RESPONSE_BYTES=2097152
MDM_MAX_CONCURRENCY=2
MDM_RATE_LIMIT_PER_SECOND=2
MDM_CACHE_MAX_AGE_SECONDS=15
MDM_BUDGET_MAX_REQUESTS=6
MDM_BUDGET_MAX_ITEMS=300
MDM_BUDGET_MAX_RESPONSE_BYTES=6291456
MDM_BUDGET_MAX_FAN_OUT=6
MDM_BUDGET_TIMEOUT_SECONDS=30
