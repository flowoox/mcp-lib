MCP_HOST=127.0.0.1
MCP_PORT=8103
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Exchange Online: app-only certificate auth plus an Exchange service principal
# assigned only view-only Exchange RBAC sufficient for the fixed Get-* cmdlets.
EXCHANGE_BACKEND_READ_ONLY=false
EXCHANGE_VIEW_ONLY_RBAC_ATTESTED=false
EXCHANGE_POWERSHELL_EXECUTABLE=pwsh
EXCHANGE_ORGANIZATION=tenant.onmicrosoft.com
EXCHANGE_APP_ID=00000000-0000-0000-0000-000000000000
EXCHANGE_CERTIFICATE_THUMBPRINT=
EXCHANGE_RETURN_DOMAIN_NAMES=false

# Microsoft Graph: separate app identity with only ServiceHealth.Read.All application permission.
M365_GRAPH_BACKEND_READ_ONLY=false
M365_GRAPH_SERVICE_HEALTH_PERMISSION_ATTESTED=false
M365_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
M365_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
M365_GRAPH_CLIENT_SECRET=
