MCP_HOST=127.0.0.1
MCP_PORT=8092
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Fail closed unless the deployment explicitly attests that the observe backend identity/endpoint is read-only.
HYPERV_BACKEND_READ_ONLY=false

# Production observe default: require each target to use a dedicated constrained JEA endpoint.
HYPERV_REQUIRE_JEA=true
HYPERV_POWERSHELL_EXECUTABLE=powershell.exe
HYPERV_TARGETS_JSON={"hv01":{"computer_name":"hv01.example.invalid","transport":"winrm","configuration_name":"FlowooxHyperVReadOnly"}}

HYPERV_MAX_PAGE_SIZE=100
HYPERV_MAX_SAMPLE_SIZE=50
HYPERV_REQUEST_TIMEOUT_SECONDS=20
HYPERV_MAX_RESPONSE_BYTES=2097152
HYPERV_MAX_CONCURRENCY=2
HYPERV_RATE_LIMIT_PER_SECOND=2
HYPERV_CACHE_MAX_AGE_SECONDS=5
HYPERV_MAX_EVENT_LOOKBACK_MINUTES=1440
HYPERV_MAX_VHD_PAGE_SIZE=32

HYPERV_BUDGET_MAX_REQUESTS=8
HYPERV_BUDGET_MAX_ITEMS=500
HYPERV_BUDGET_MAX_RESPONSE_BYTES=8388608
HYPERV_BUDGET_MAX_FAN_OUT=8
HYPERV_BUDGET_TIMEOUT_SECONDS=45

# Optional high-risk write boundary: create one ProductionOnly checkpoint before a controlled change.
# The checkpoint endpoint MUST be a separate constrained JEA endpoint from the read-only target.
HYPERV_CHECKPOINT_WRITES_ENABLED=false
HYPERV_CHECKPOINT_BACKEND_CONSTRAINED=false
HYPERV_CHECKPOINT_TARGETS_JSON={"hv01":{"computer_name":"hv01.example.invalid","transport":"winrm","configuration_name":"FlowooxHyperVCheckpoint"}}
HYPERV_CHECKPOINT_APPROVAL_SECRET=
HYPERV_CHECKPOINT_RECEIPT_STORE=C:/ProgramData/flowoox/mcp-hyperv/checkpoint-receipts.json
HYPERV_CHECKPOINT_MAX_EXISTING=8
HYPERV_CHECKPOINT_TIMEOUT_SECONDS=120
HYPERV_CHECKPOINT_MAX_RESPONSE_BYTES=262144
