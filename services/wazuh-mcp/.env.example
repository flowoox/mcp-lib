MCP_HOST=127.0.0.1
MCP_PORT=8099
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Wazuh server API (normally https://manager.example:55000)
WAZUH_SERVER_API_BASE_URL=https://wazuh-manager.example:55000
WAZUH_SERVER_USERNAME=svc-mcp-wazuh
WAZUH_SERVER_PASSWORD=replace-me
WAZUH_SERVER_BACKEND_READ_ONLY=true
WAZUH_SERVER_BACKEND_ROLE=readonly
WAZUH_SERVER_TLS_VERIFY=true

# Wazuh indexer API (normally https://indexer.example:9200).
# Create a deployment-owned role with cluster_composite_ops_ro and read only on:
#   wazuh-alerts-* and wazuh-states-vulnerabilities-*
WAZUH_INDEXER_API_BASE_URL=https://wazuh-indexer.example:9200
WAZUH_INDEXER_USERNAME=svc-mcp-wazuh-indexer
WAZUH_INDEXER_PASSWORD=replace-me
WAZUH_INDEXER_BACKEND_READ_ONLY=true
WAZUH_INDEXER_BACKEND_ROLE=mcp_wazuh_observer
WAZUH_INDEXER_TLS_VERIFY=true

WAZUH_MAX_PAGE_SIZE=100
WAZUH_MAX_SAMPLE_SIZE=50
WAZUH_MAX_OFFSET=10000
WAZUH_MAX_ALERT_WINDOW_MINUTES=1440
WAZUH_REQUEST_TIMEOUT_SECONDS=8
WAZUH_MAX_RESPONSE_BYTES=2097152
WAZUH_MAX_CONCURRENCY=2
WAZUH_RATE_LIMIT_PER_SECOND=1
WAZUH_CACHE_MAX_AGE_SECONDS=15

WAZUH_BUDGET_MAX_REQUESTS=8
WAZUH_BUDGET_MAX_ITEMS=300
WAZUH_BUDGET_MAX_RESPONSE_BYTES=8388608
WAZUH_BUDGET_MAX_FAN_OUT=4
WAZUH_BUDGET_TIMEOUT_SECONDS=30
