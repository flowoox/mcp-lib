# MCP listener/auth. Bind externally only behind an authenticated reverse proxy or configure MCP auth.
MCP_HOST=127.0.0.1
MCP_PORT=8096
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Deployment-owned Freshdesk origin and a dedicated least-privilege view-only agent API key.
# Example origin: https://your-helpdesk.freshdesk.com (origin only; do not include /api/v2).
# FRESHDESK_BACKEND_READ_ONLY is an explicit operator attestation that the API key belongs to a
# Freshdesk role restricted to the ticket visibility needed by this MCP and cannot perform writes.
FRESHDESK_API_BASE_URL=
FRESHDESK_API_KEY=
FRESHDESK_BACKEND_READ_ONLY=false
FRESHDESK_ALLOW_INSECURE_HTTP=false
FRESHDESK_TLS_VERIFY=true

FRESHDESK_MAX_PAGE_SIZE=100
FRESHDESK_MAX_SAMPLE_SIZE=50
FRESHDESK_MAX_PAGE_NUMBER=50
FRESHDESK_REQUEST_TIMEOUT_SECONDS=8
FRESHDESK_MAX_RESPONSE_BYTES=2097152
FRESHDESK_MAX_CONCURRENCY=2
FRESHDESK_RATE_LIMIT_PER_SECOND=0.5
FRESHDESK_CACHE_MAX_AGE_SECONDS=15
FRESHDESK_BUDGET_MAX_REQUESTS=5
FRESHDESK_BUDGET_MAX_ITEMS=250
FRESHDESK_BUDGET_MAX_RESPONSE_BYTES=6291456
FRESHDESK_BUDGET_MAX_FAN_OUT=4
FRESHDESK_BUDGET_TIMEOUT_SECONDS=30
