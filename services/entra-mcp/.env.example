MCP_HOST=127.0.0.1
MCP_PORT=8088
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Supported values: global, usgov, dod, china.
ENTRA_CLOUD=global
# Use GUIDs, not tenant aliases such as common/organizations.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
# Explicit deployment attestation: the app registration has read-only Graph application permissions only.
ENTRA_BACKEND_READ_ONLY=true

ENTRA_MAX_PAGE_SIZE=100
ENTRA_MAX_SAMPLE_SIZE=50
ENTRA_REQUEST_TIMEOUT_SECONDS=8
ENTRA_MAX_RESPONSE_BYTES=2097152
ENTRA_MAX_CONCURRENCY=2
ENTRA_RATE_LIMIT_PER_SECOND=4
ENTRA_CACHE_MAX_AGE_SECONDS=10

ENTRA_BUDGET_MAX_REQUESTS=10
ENTRA_BUDGET_MAX_ITEMS=500
ENTRA_BUDGET_MAX_RESPONSE_BYTES=8388608
ENTRA_BUDGET_MAX_FAN_OUT=10
ENTRA_BUDGET_TIMEOUT_SECONDS=30
