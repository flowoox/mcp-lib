MCP_HOST=127.0.0.1
MCP_PORT=8087
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Use a dedicated FortiOS REST API administrator with read-only permissions.
# Keep the token in runtime secret storage, not in this file in production.
FORTIGATE_BASE_URL=https://fortigate.example.invalid
FORTIGATE_API_TOKEN=
FORTIGATE_BACKEND_READ_ONLY=true
FORTIGATE_DEFAULT_VDOM=root
# Semicolon-separated explicit VDOM allowlist.
FORTIGATE_ALLOWED_VDOMS=root
FORTIGATE_TLS_VERIFY=true
FORTIGATE_ALLOW_INSECURE_TLS=false
# FORTIGATE_CA_BUNDLE=/run/secrets/fortigate_ca.pem

FORTIGATE_MAX_PAGE_SIZE=100
FORTIGATE_MAX_SAMPLE_SIZE=50
FORTIGATE_REQUEST_TIMEOUT_SECONDS=8
FORTIGATE_MAX_RESPONSE_BYTES=2097152
FORTIGATE_MAX_CONCURRENCY=2
FORTIGATE_RATE_LIMIT_PER_SECOND=3
FORTIGATE_CACHE_MAX_AGE_SECONDS=5

FORTIGATE_BUDGET_MAX_REQUESTS=8
FORTIGATE_BUDGET_MAX_ITEMS=400
FORTIGATE_BUDGET_MAX_RESPONSE_BYTES=8388608
FORTIGATE_BUDGET_MAX_FAN_OUT=8
FORTIGATE_BUDGET_TIMEOUT_SECONDS=30
