MCP_HOST=127.0.0.1
MCP_PORT=8085
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Safe default: loopback only. Production deployments must explicitly widen
# this to the exact networks the MCP identity is authorized to diagnose.
NETWORK_ALLOWED_CIDRS=127.0.0.0/8,::1/128
NETWORK_OPERATION_TIMEOUT_SECONDS=5
NETWORK_MAX_RESOLVED_ADDRESSES=16
NETWORK_MAX_PORTS_PER_BUNDLE=8

# Path tracing is active network traffic and remains disabled unless the
# deployment explicitly opts in. The implementation still applies the CIDR
# authorization boundary and bounded fixed executable policy when enabled.
NETWORK_PATH_TRACE_ENABLED=false
NETWORK_PATH_TRACE_MAX_HOPS=20
NETWORK_PATH_TRACE_PROCESS_TIMEOUT_SECONDS=30
