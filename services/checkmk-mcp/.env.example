MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Full stable Checkmk site REST root, including the site name.
CHECKMK_API_BASE_URL=https://checkmk.example/mysite/check_mk/api/1.0
CHECKMK_USERNAME=svc-mcp-checkmk
CHECKMK_AUTOMATION_SECRET=replace-me
CHECKMK_BACKEND_READ_ONLY=true
# Deployment-owned custom role / permission boundary. Keep it monitoring-read only and contact scoped.
CHECKMK_BACKEND_ROLE=mcp_monitoring_observer
CHECKMK_TLS_VERIFY=true
CHECKMK_ALLOW_INSECURE_HTTP=false

CHECKMK_MAX_PAGE_SIZE=100
CHECKMK_MAX_SAMPLE_SIZE=50
CHECKMK_REQUEST_TIMEOUT_SECONDS=8
CHECKMK_MAX_RESPONSE_BYTES=2097152
CHECKMK_MAX_CONCURRENCY=2
CHECKMK_RATE_LIMIT_PER_SECOND=1
CHECKMK_CACHE_MAX_AGE_SECONDS=10

CHECKMK_BUDGET_MAX_REQUESTS=6
CHECKMK_BUDGET_MAX_ITEMS=300
CHECKMK_BUDGET_MAX_RESPONSE_BYTES=8388608
CHECKMK_BUDGET_MAX_FAN_OUT=4
CHECKMK_BUDGET_TIMEOUT_SECONDS=30
