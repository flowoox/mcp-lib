# Active Directory connection. Prefer a dedicated read-only service account.
AD_HOST=dc.example.internal
AD_PORT=636
AD_USE_SSL=true
AD_START_TLS=false
AD_ALLOW_INSECURE=false
AD_VALIDATE_CERTIFICATE=true
# AD_CA_FILE=/run/secrets/ad-ca.pem
# AD_SERVER_NAME=dc.example.internal
AD_BIND_DN=CN=mcp-reader,OU=Service Accounts,DC=example,DC=internal
AD_BIND_PASSWORD=replace-at-runtime
AD_BASE_DN=DC=example,DC=internal
# Semicolon-separated, all constrained beneath deployment-owned scopes.
AD_ALLOWED_BASE_DNS=OU=Users,DC=example,DC=internal;OU=Groups,DC=example,DC=internal
AD_PRIVILEGED_GROUP_DNS=CN=Domain Admins,CN=Users,DC=example,DC=internal
AD_MAX_RESULTS=200
AD_STALE_DAYS=90
AD_MIN_PASSWORD_LENGTH=14

MCP_HOST=0.0.0.0
MCP_PORT=8091
MCP_TRANSPORT=streamable-http
MCP_TRUST_BOUNDARY=external
MCP_PUBLIC_URL=https://ad-mcp.example.internal/mcp
MCP_AUTH_TOKEN=replace-at-runtime
MCP_ALLOWED_HOSTS=ad-mcp.example.internal
MCP_ALLOWED_ORIGINS=https://automation.example.internal
