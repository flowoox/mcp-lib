MCP_HOST=127.0.0.1
MCP_PORT=8102
MCP_TRUST_BOUNDARY=internal
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=
MCP_ISSUER_URL=
MCP_AUTH_TOKEN=

# Both flags are mandatory production attestations. The backend identity must be dedicated
# and limited to read-only observation, including explicit "View CA database" access.
PKI_BACKEND_READ_ONLY=true
PKI_BACKEND_VIEW_CA_DATABASE_ATTESTED=true
PKI_POWERSHELL_EXECUTABLE=powershell.exe

# Deployment-owned topology only. Do not commit real hosts, CA names or credentials.
# Each endpoint must be a dedicated constrained JEA session configuration, not Microsoft.PowerShell.
PKI_TARGETS_JSON={"issuing-ca":{"computer_name":"ca.example.invalid","configuration_name":"McpPkiObserve","ca_config":"ca.example.invalid\\Example Issuing CA"}}

PKI_MAX_PAGE_SIZE=100
PKI_MAX_SAMPLE_SIZE=50
PKI_REQUEST_TIMEOUT_SECONDS=20
PKI_MAX_RESPONSE_BYTES=2097152
PKI_MAX_CONCURRENCY=1
PKI_RATE_LIMIT_PER_SECOND=0.5
PKI_CACHE_MAX_AGE_SECONDS=15
PKI_MAX_EXPIRY_DAYS=180
PKI_MAX_EVENT_LOOKBACK_MINUTES=1440

PKI_BUDGET_MAX_REQUESTS=6
PKI_BUDGET_MAX_ITEMS=300
PKI_BUDGET_MAX_RESPONSE_BYTES=8388608
PKI_BUDGET_MAX_FAN_OUT=4
PKI_BUDGET_TIMEOUT_SECONDS=45
